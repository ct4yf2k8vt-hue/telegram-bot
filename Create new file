import urllib.request, urllib.parse, json, time
import os
import threading
from http.server import BaseHTTPRequestHandler, HTTPServer

T = os.environ.get("BOT_TOKEN")
C = "1623907197"

def tg(m):
    try:
        d = urllib.parse.urlencode({"chat_id": C, "text": m, "parse_mode": "HTML", "disable_web_page_preview": True}).encode()
        urllib.request.urlopen("https://api.telegram.org/bot" + T + "/sendMessage", d, timeout=10).read()
    except:
        pass

def gj(u):
    try:
        return json.loads(urllib.request.urlopen(u, timeout=20).read().decode())
    except:
        return None

def bot_loop():
    S = []
    while not S:
        info = gj("https://fapi.binance.com/fapi/v1/exchangeInfo")
        if info and "symbols" in info:
            S = [x["symbol"] for x in info["symbols"] if x["status"] == "TRADING" and x["quoteAsset"] == "USDT" and x["contractType"] == "PERPETUAL"]
        if not S:
            print("Binance API yanit vermedi, 10 saniye sonra tekrar denenecek...")
            time.sleep(10)
    tg("PUMP/DUMP BOTU AKTIF " + str(len(S)))
    son = {}
    while True:
        try:
            for s in S:
                try:
                    # 4 saatlik veri
                    k = gj("https://fapi.binance.com/fapi/v1/klines?symbol=" + s + "&interval=4h&limit=50")
                    if not k or len(k) < 20:
                        continue
                    m = k[-2]  # son kapanmis mum
                    o = float(m[1])
                    c = float(m[4])
                    h = float(m[2])
                    l = float(m[3])
                    v = float(m[5])
                    if o == 0:
                        continue
                    degisim = ((c - o) / o) * 100
                    # 24 saatlik hacim
                    v24 = sum(float(x[5]) for x in k[-6:])
                    # Hacim patlamasi kontrolu: son mumun hacmi, son 20 mumun ortalamasinin 2 kati mi?
                    v_ort = sum(float(x[5]) for x in k[-22:-2]) / 20
                    if v_ort == 0:
                        continue
                    v_oran = v / v_ort
                    # Esik: %3+ hareket VE hacim 2x+
                    if abs(degisim) >= 3 and v_oran >= 2:
                        if time.time() - son.get(s, 0) >= 1800:
                            if degisim > 0:
                                yon = "PUMP"
                                emoji = "🚀"
                                yazi = "#" + s + " - PUMP"
                            else:
                                yon = "DUMP"
                                emoji = "⚠️"
                                yazi = "#" + s + " - DUMP"
                            v_candle = v * c
                            v24_usdt = v24 * c
                            msg = (emoji + " <b>" + yazi + "</b>\n"
                                   "Price: $" + format(o, ".4f") + " ➜ $" + format(c, ".4f") + " (" + format(degisim, ".2f") + "%)\n"
                                   "Volume Candle: $" + format(v_candle / 1000000, ".3f") + "M\n"
                                   "Volume 24h: $" + format(v24_usdt / 1000000, ".2f") + "M\n\n"
                                   "Time: " + time.strftime("%d/%m/%Y %H:%M (UTC)", time.gmtime()) + "\n"
                                   "Link: marketowl.eu")
                            tg(msg)
                            son[s] = time.time()
                            print(s, yon, format(degisim, ".2f"), format(v_oran, ".2f"))
                except:
                    pass
            print("Tarama bitti")
            time.sleep(300)
        except Exception as e:
            print("Hata:", e)
            time.sleep(30)

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Bot is running!")
    def do_HEAD(self):
        self.send_response(200)
        self.end_headers()

def run_web_server():
    port = int(os.environ.get("PORT", 10000))
    server = HTTPServer(("0.0.0.0", port), Handler)
    server.serve_forever()

if __name__ == "__main__":
    bot_thread = threading.Thread(target=bot_loop)
    bot_thread.daemon = True
    bot_thread.start()
    run_web_server()
